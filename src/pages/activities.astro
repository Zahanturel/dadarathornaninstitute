---

<PageLayout
  title="Activities"
  description="Annual activities and events of the Dadar Athornan Institute — academic results, Navar ceremonies, Jashans, and more."
  pageTitle="Institute Activities"
  pageSubtitle="Annual reports and highlights"
>
  <div class="space-y-3">
    {years.map((y, i) => (
      <details class="group rounded-xl border border-stone-200 overflow-hidden" open={i === 0}>
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer select-none transition-colors hover:bg-stone-50" style={i === 0 ? 'background-color: rgba(22,45,74,0.05);' : ''}>
          <span class="font-serif text-lg font-semibold" style="color: #162d4a;">{y.year}</span>
          <span class="text-stone-400 group-open:rotate-180 transition-transform duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 pt-2 border-t border-stone-100">
          <ul class="space-y-2">
            {y.items.map(item => (
              <li class="flex gap-3 text-sm text-stone-700 leading-relaxed">
                <span class="flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full" style="background-color: #b45309;"></span>
                <span set:html={item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))}
  </div>

  <div class="mt-10 p-5 rounded-xl bg-stone-50 border border-stone-200 text-sm text-stone-600">
    <p>For a full brochure of Institute activities, download the <a href={`${base}/brochure-2022.pdf`} target="_blank" rel="noopener" class="font-medium hover:underline" style="color: #b45309;">2022 Brochure (PDF)</a>.</p>
  </div>
</PageLayout>
