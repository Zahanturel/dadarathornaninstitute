    items: [
      'SSC 2017: Farzan Kurush Dastur (86.40%).',
      'Annual activities including Jashan, prize-giving ceremony and cultural programmes.',
      'New admissions taken in June 2017.',
    ],
  },
  {
    year: '2016',
    items: [
      'Annual Jashan and prize-giving ceremony held.',
      'Religious education and scriptural training continued.',
      'Cultural and recreational activities organised for students.',
    ],
  },
  {
    year: '2015',
    items: [
      'SSC 2015: Ardeshirshaw R. Nariman (81.00%).',
      'Annual Jashan and prize distribution held.',
      'New admissions in June 2015.',
    ],
  },
  {
    year: '2014',
    items: [
      'SSC 2014: Kayomarz H. Panthaky (78.20%).',
      'Annual Jashan celebrated.',
      'Prize-giving ceremony and cultural events held.',
    ],
  },
  {
    year: '2013',
    items: [
      'Annual Jashan, prize-giving ceremony and cultural programmes.',
      'Religious education, Avesta classes and scriptural training continued.',
    ],
  },
  {
    year: '2012',
    items: [
      'Annual Jashan and prize-giving ceremony held.',
      'Cultural and recreational activities organised.',
      'New admissions taken in June 2012.',
    ],
  },
  {
    year: '2011',
    items: [
      'Annual Jashan celebrated with full priestly rituals.',
      'Prize-giving ceremony held.',
      'Religious knowledge classes and scriptural training continued.',
    ],
  },
  {
    year: '2010',
    items: [
      'SSC 2010: Shehrezad Rohinton Pavri (94.00%), Rayan Darayus Dastur (77.09%).',
      'Annual Jashan and prize distribution held.',
      'New admissions taken in June 2010.',
    ],
