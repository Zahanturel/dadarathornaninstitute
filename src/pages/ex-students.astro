---
import PageLayout from '../components/PageLayout.astro';
import { getExStudents } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = getExStudents();
---

<PageLayout
  title="Ex-Students"
  description="Information about ex-students of Dadar Athornan Institute — careers and present status."
  pageTitle="Ex-Students"
  pageSubtitle={`Information as on ${data.updated}`}
>
  <div class="space-y-6">
    <div class="p-4 rounded-lg bg-stone-50 border border-stone-200 text-sm text-stone-600">
      {data.note} Email <a href="mailto:info@dadarathornaninstitute.org" class="hover:underline text-terracotta-600">info@dadarathornaninstitute.org</a> or call +91-22-2413 8086.
    </div>

    <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
      <table class="w-full text-sm" id="ex-students-table">
        <thead>
          <tr class="table-header">
            <th class="px-4 py-3 text-left font-medium w-28">Years</th>
            <th class="px-4 py-3 text-left font-medium w-48">Name</th>
            <th class="px-4 py-3 text-left font-medium">Present Status</th>
          </tr>
        </thead>
        <tbody>
          {data.students.map((s, i) => (
            <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'}`}>
              <td class="px-4 py-3 text-stone-500 whitespace-nowrap">{s.years}</td>
              <td class="px-4 py-3 font-medium text-stone-800">{s.name}</td>
              <td class="px-4 py-3 text-stone-600">{s.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="border-t border-stone-200 pt-6 space-y-3">
      <p class="text-sm text-stone-600">
        The Institute's complete student register — every boy admitted since 1919, with entry and exit dates, panthak, and Navar and Maratab details.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={`${base}/dai_alumni_complete_list.pdf`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-all hover:opacity-90 bg-institute-900"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Alumni Complete List (PDF)
        </a>
        <a
          href={`${base}/dai_alumni_complete_list.xls`}
          target="_blank"
          rel="noopener"
          class="btn-secondary"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Alumni Complete List (XLS)
        </a>
      </div>
    </div>
  </div>
</PageLayout>
