---
import PageLayout from '../components/PageLayout.astro';
import { getStudentList, getCurrentStudentYear } from '../lib/data';

const currentYear = getCurrentStudentYear();
const studentData = getStudentList(currentYear);
---

<PageLayout
  title="Students"
  description={`Current list of students at Dadar Athornan Institute — academic year ${studentData.label}.`}
  pageTitle="Current Students"
  pageSubtitle={`List of Students (${currentYear.replace('-', '–')})`}
>
  <div class="space-y-8">
    <div class="text-center">
      <h2 class="font-serif text-xl font-semibold mb-1 text-institute-900">
        List of Students of Dadar Athornan Institute
      </h2>
      <p class="text-stone-500 text-sm">{studentData.schoolLabel}</p>
    </div>

    <section>
      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="table-header">
              <th class="px-4 py-3 text-left font-medium w-14">No.</th>
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-center font-medium w-24">Std.</th>
            </tr>
          </thead>
          <tbody>
            {studentData.students.map((s, i) => (
              <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'} hover:bg-terracotta-50 transition-colors`}>
                <td class="px-4 py-3 text-stone-500 font-medium">{s.no}.</td>
                <td class="px-4 py-3 font-medium text-stone-800">{s.name}</td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-block px-2.5 py-0.5 rounded bg-stone-200 text-stone-600 text-xs font-medium">{s.std}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-right text-sm text-stone-500 mt-3 font-medium">Total: Fourteen ({studentData.total}) students</p>
    </section>
  </div>
</PageLayout>
