---
import PageLayout from '../components/PageLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const schoolStudents = [
  { no: 1, name: 'Yazdan Firdosh Panthaki', std: 'II' },
  { no: 2, name: 'Pashaang Daraius Karanjia', std: 'IV' },
  { no: 3, name: 'Delyaz Marzban Panthaky', std: 'IV' },
  { no: 4, name: 'Kaiwan Kurush Sidhwa', std: 'IV' },
  { no: 5, name: 'Huzan Zubin Engineer', std: 'V' },
  { no: 6, name: 'Ziyan Zubin Nalladaru', std: 'VI' },
  { no: 7, name: 'Maidyarem Kaizad Chinoy', std: 'VII' },
  { no: 8, name: 'Aryameher Ruzbe Ruwala', std: 'VII' },
  { no: 9, name: 'Barjis Kobad Bharda', std: 'VIII' },
  { no: 10, name: 'Shahan Hoshang Bhesadia', std: 'VIII' },
  { no: 11, name: 'Zhian Meherzad Turel', std: 'VIII' },
  { no: 12, name: 'Sarosh Khushru Bharucha', std: 'IX' },
  { no: 13, name: 'Farsogar Jal Bhesadia', std: 'X' },
  { no: 14, name: 'Shyamak Rumi Sanjana', std: 'FY-BAF' },
];
---

<PageLayout
  title="Students"
  description="Current list of students at Dadar Athornan Institute studying in the D.P.Y.A. High School — year 2023–24."
  pageTitle="Current Students"
  pageSubtitle="Academic year 2023–24"
>
  <div class="space-y-8">
    <div class="text-center">
      <h2 class="font-serif text-xl font-semibold mb-1" style="color: #162d4a;">
        List of Students of Dadar Athornan Institute
      </h2>
      <p class="text-stone-500 text-sm">Studying in the D.P.Y.A. High School — Year 2023–24</p>
    </div>

    <section>
      <h3 class="font-semibold text-stone-700 text-sm uppercase tracking-wide mb-3">School Students</h3>
      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr style="background-color: #162d4a; color: white;">
              <th class="px-4 py-3 text-left font-medium w-14">No.</th>
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-center font-medium w-24">Std.</th>
            </tr>
          </thead>
          <tbody>
            {schoolStudents.map((s, i) => (
              <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'} hover:bg-amber-50 transition-colors`}>
                <td class="px-4 py-3 text-stone-500 font-medium">{s.no}.</td>
                <td class="px-4 py-3 font-medium text-stone-800">{s.name}</td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-block px-2.5 py-0.5 rounded bg-stone-200 text-stone-600 text-xs font-medium">{s.std}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-right text-sm text-stone-500 mt-3 font-medium">Total: Fourteen (14) students</p>
    </section>

    <div class="border-t border-stone-200 pt-6 flex flex-wrap gap-4">
      <a
        href={`${base}/dai_alumni_complete_list_jul_12.xls`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-all hover:opacity-90"
        style="background-color: #162d4a;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Alumni Complete List (XLS)
      </a>
      <a
        href={`${base}/ex_students.pdf`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-all hover:opacity-90 border"
        style="color: #162d4a; border-color: #162d4a;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Ex-Students List (PDF)
      </a>
    </div>
  </div>
</PageLayout>
