---
import PageLayout from '../components/PageLayout.astro';
---

<PageLayout
  title="Contact"
  description="Contact the Dadar Athornan Institute — address, phone, email and enquiry form."
  pageTitle="Contact Us"
  pageSubtitle="Get in touch with the Institute"
>
  <div class="grid md:grid-cols-2 gap-10">
    <!-- Contact Info -->
    <div class="space-y-6">
      <div>
        <h2 class="font-serif text-xl font-semibold mb-4" style="color: #162d4a;">Address</h2>
        <div class="grid sm:grid-cols-1 gap-5">
          <div class="p-5 rounded-xl bg-stone-50 border border-stone-200">
            <p class="font-semibold text-stone-800 mb-2">The Principal</p>
            <address class="not-italic text-sm text-stone-600 space-y-0.5">
              <p>The Dadar Athornan Institute,</p>
              <p>651–52, Firdausi Road,</p>
              <p>Mancherji Joshi Parsi Colony,</p>
              <p>Dadar, Mumbai 400 014. INDIA.</p>
              <p class="mt-3">
                <span class="font-medium text-stone-700">Telephone:</span> 2413 8086
              </p>
              <p>
                <span class="font-medium text-stone-700">Email:</span>
                <a href="mailto:info@dadarathornaninstitute.org" class="hover:underline ml-1" style="color: #b45309;">
                  info@dadarathornaninstitute.org
                </a>
              </p>
            </address>
          </div>

          <div class="p-5 rounded-xl bg-stone-50 border border-stone-200">
            <p class="font-semibold text-stone-800 mb-2">The Joint Honorary Secretaries</p>
            <address class="not-italic text-sm text-stone-600 space-y-0.5">
              <p>Athornan Mandal,</p>
              <p>240, Navsari Bldg., 2nd Flr.,</p>
              <p>Dr. Dadabhai Navroji Road,</p>
              <p>Fort, Mumbai 400 001. INDIA.</p>
              <p class="mt-3">
                <span class="font-medium text-stone-700">Telephone:</span> 2207 0784
              </p>
            </address>
          </div>
        </div>
      </div>
    </div>

    <!-- Enquiry Form -->
    <div>
      <h2 class="font-serif text-xl font-semibold mb-4" style="color: #162d4a;">Send an Enquiry</h2>
      <form
        method="post"
        action="https://formsubmit.co/info@dadarathornaninstitute.org"
        class="space-y-4"
        id="contact-form"
      >
        <input type="hidden" name="_subject" value="Enquiry from dadarathornaninstitute.org" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://dadarathornaninstitute.org/contact?sent=1" />

        <div>
          <label for="Name" class="block text-sm font-medium text-stone-700 mb-1">Name <span class="text-red-500">*</span></label>
          <input
            type="text"
            name="Name"
            id="Name"
            required
            maxlength="100"
            class="w-full px-4 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:border-transparent bg-white"
            style="focus:ring-color: #b45309;"
          />
        </div>

        <div>
          <label for="Phone" class="block text-sm font-medium text-stone-700 mb-1">Phone</label>
          <input
            type="tel"
            name="Phone"
            id="Phone"
            maxlength="20"
            class="w-full px-4 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:border-transparent bg-white"
          />
        </div>

        <div>
          <label for="Email" class="block text-sm font-medium text-stone-700 mb-1">Email <span class="text-red-500">*</span></label>
          <input
            type="email"
            name="Email"
            id="Email"
            required
            maxlength="100"
            class="w-full px-4 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:border-transparent bg-white"
          />
        </div>

        <div>
          <label for="Comment" class="block text-sm font-medium text-stone-700 mb-1">Query <span class="text-red-500">*</span></label>
          <textarea
            name="Comment"
            id="Comment"
            rows="5"
            required
            class="w-full px-4 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:border-transparent bg-white resize-y"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded-lg font-medium text-white transition-all hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2"
          style="background-color: #b45309;"
        >
          Submit Enquiry
        </button>
      </form>
    </div>
  </div>
</PageLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('sent') === '1') {
    const form = document.getElementById('contact-form');
    if (form) {
      form.insertAdjacentHTML('beforebegin', `
        <div class="mb-6 p-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm font-medium">
          Thank you for your enquiry. We will get back to you shortly.
        </div>
      `);
    }
  }
</script>
