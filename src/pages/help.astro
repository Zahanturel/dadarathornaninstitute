---
import { base, withBase } from '../lib/paths';

const target = `${base}/donate/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`2;url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Page moved — Schemes &amp; Support</title>
  <link rel="icon" type="image/jpeg" href={withBase('/images/logo.jpg')} />
</head>
<body style="font-family: system-ui, sans-serif; max-width: 32rem; margin: 4rem auto; padding: 0 1rem; color: #444;">
  <p>This page has moved to <a href={target}>Schemes &amp; Support</a>. Redirecting…</p>
</body>
</html>
