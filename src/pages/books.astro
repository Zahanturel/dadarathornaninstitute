---
import PageLayout from '../components/PageLayout.astro';

const books = [
  { no: 1, title: 'Afargan, Farokhshi, Afrin & All Khshnuman', lang: 'G', price: '300' },
  { no: 2, title: 'Geh sarna prayers', lang: 'G', price: '50' },
  { no: 3, title: 'Nuptial Blessings - Lagan na Ashirwad', lang: 'EG', price: '100' },
  { no: 4, title: 'Yazashne Concise', lang: 'E', price: '300' },
  { no: 5, title: 'Yazashne Full', lang: 'E', price: '500' },
  { no: 6, title: 'Yazashne Full', lang: 'G', price: '300' },
  { no: 7, title: 'Vendidad', lang: 'E', price: '500' },
  { no: 8, title: 'Vendidad', lang: 'G', price: '500' },
  { no: 9, title: 'Farokhshi', lang: 'G', price: '100' },
  { no: 10, title: 'Farokhshi', lang: 'E', price: '100' },
  { no: 11, title: 'Tamam khordeh Avesta', lang: 'G', price: '300' },
  { no: 12, title: 'History of Athornan Mandal by R.P. Karanjia', lang: '', price: '200' },
  { no: 13, title: 'History of Dadar Athornan Institute by R.P. Karanjia', lang: '', price: '200' },
  { no: 14, title: 'Outlines of Parsi History by H.K. Mirza', lang: '', price: '500' },
  { no: 15, title: 'My God – Ahura Mazda (Children\'s activity book) by R.P. Karanjia', lang: '', price: '300' },
  { no: 16, title: 'My Prophet – Zarathushtra (Children\'s activity book) by R.P. Karanjia', lang: '', price: '300' },
  { no: 17, title: 'Stories from the Iranian Epic-Shahnameh (Peshdad) by R.P. Karanjia', lang: '', price: '300' },
  { no: 18, title: 'Stories from the Iranian Epic-Shahnameh (Kayan) by R.P. Karanjia', lang: '', price: '500' },
  { no: 19, title: 'A Treasury of Zoroastrian Quotations by JJ Modi (Tr: R.P. Karanjia)', lang: '', price: '300' },
];

const langLabel: Record<string, string> = {
  'E': 'English',
  'G': 'Gujarati',
  'EG': 'English & Gujarati',
};
---

<PageLayout
  title="Books Available"
  description="Books available for purchase from the Dadar Athornan Institute — scriptural texts, religious books, and historical works."
  pageTitle="Books Available"
  pageSubtitle="Zoroastrian scriptural texts and publications"
>
  <div class="mb-6 p-4 rounded-lg bg-stone-50 border border-stone-200 text-sm text-stone-600">
    <strong>Language codes:</strong> (E) — English &nbsp;·&nbsp; (G) — Gujarati &nbsp;·&nbsp; (EG) — English &amp; Gujarati
  </div>

  <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr style="background-color: #162d4a; color: white;">
          <th class="px-4 py-3 text-left font-medium w-12">No.</th>
          <th class="px-4 py-3 text-left font-medium">Title</th>
          <th class="px-4 py-3 text-center font-medium w-28">Language</th>
          <th class="px-4 py-3 text-right font-medium w-28">Price (₹)</th>
        </tr>
      </thead>
      <tbody>
        {books.map((book, i) => (
          <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'} hover:bg-amber-50 transition-colors`}>
            <td class="px-4 py-3 text-stone-500 font-medium">{book.no}.</td>
            <td class="px-4 py-3 text-stone-800 font-medium">{book.title}</td>
            <td class="px-4 py-3 text-center">
              {book.lang && (
                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium text-stone-600 bg-stone-200">
                  {langLabel[book.lang] || book.lang}
                </span>
              )}
            </td>
            <td class="px-4 py-3 text-right font-semibold" style="color: #b45309;">₹{book.price}/-</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-8 p-5 rounded-xl bg-stone-50 border border-stone-200">
    <p class="text-sm text-stone-600 leading-relaxed">
      To purchase books or enquire about availability, please contact the Institute directly.
    </p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      <a href="tel:+912224138086" class="font-medium hover:underline" style="color: #b45309;">+91-22-2413 8086</a>
      <a href="mailto:info@dadarathornaninstitute.org" class="font-medium hover:underline" style="color: #b45309;">info@dadarathornaninstitute.org</a>
    </div>
  </div>
</PageLayout>
