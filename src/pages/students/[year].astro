---
import PageLayout from '../../components/PageLayout.astro';
import { getStudentList, getArchivedStudentYears, getCurrentStudentYear } from '../../lib/data';

export function getStaticPaths() {
  return getArchivedStudentYears().map((a) => ({
    params: { year: a.id },
  }));
}

const { year } = Astro.params;
const studentData = getStudentList(year!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = getCurrentStudentYear();
---

<PageLayout
  title={`Students ${studentData.label}`}
  description={`Archived student list — ${studentData.label}.`}
  pageTitle="Students Archive"
  pageSubtitle={studentData.label}
>
  <div class="space-y-8">
    <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-stone-700">
      This is an archived list. View the <a href={`${base}/students`} class="font-medium hover:underline" style="color: #b45309;">current students ({currentYear.replace('-', '–')})</a>.
    </div>

    <div class="text-center">
      <h2 class="font-serif text-xl font-semibold mb-1" style="color: #162d4a;">
        List of Students of Dadar Athornan Institute
      </h2>
      <p class="text-stone-500 text-sm">{studentData.schoolLabel}</p>
    </div>

    <section>
      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr style="background-color: #162d4a; color: white;">
              <th class="px-4 py-3 text-left font-medium w-14">No.</th>
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-center font-medium w-24">Std.</th>
            </tr>
          </thead>
          <tbody>
            {studentData.students.map((s, i) => (
              <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'}`}>
                <td class="px-4 py-3 text-stone-500 font-medium">{s.no}.</td>
                <td class="px-4 py-3 font-medium text-stone-800">{s.name}</td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-block px-2.5 py-0.5 rounded bg-stone-200 text-stone-600 text-xs font-medium">{s.std}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-right text-sm text-stone-500 mt-3 font-medium">Total: Fourteen ({studentData.total}) students</p>
    </section>
  </div>
</PageLayout>
