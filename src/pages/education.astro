---
import PageLayout from '../components/PageLayout.astro';
import { getEducation } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const education = getEducation();
---

<PageLayout
  title="Education & Syllabus"
  description="Education at Dadar Athornan Institute — scriptural training curriculum and syllabus downloads."
  pageTitle="Education &amp; Syllabus"
  pageSubtitle="Scriptural training and religious studies"
>
  <div class="space-y-10">
    <div class="text-stone-700 leading-relaxed text-justify">
      <p>{education.intro}</p>
    </div>

    <section>
      <h2 class="font-serif text-2xl font-semibold mb-4" style="color: #162d4a;">Syllabus Downloads</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {education.syllabi.map((s) => (
          <a
            href={`${base}${s.href}`}
            target="_blank"
            rel="noopener"
            class="p-4 rounded-xl border border-stone-200 bg-stone-50 hover:border-amber-400 hover:shadow-sm transition-all group"
          >
            <p class="font-medium text-stone-800 group-hover:text-amber-800">{s.title}</p>
            <p class="text-xs text-stone-500 mt-1">Download DOC</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold mb-4" style="color: #162d4a;">Seven-Year Scriptural Training</h2>
      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr style="background-color: #162d4a; color: white;">
              <th class="px-4 py-2 text-left font-medium">Year</th>
              <th class="px-4 py-2 text-left font-medium">Texts Covered</th>
            </tr>
          </thead>
          <tbody class="text-stone-700">
            {education.curriculum.map((row, i) => (
              <tr class={`border-b border-stone-200 ${i % 2 === 0 ? 'bg-stone-50' : 'bg-white'}`}>
                <td class="px-4 py-3 font-medium whitespace-nowrap">{row.year}</td>
                <td class="px-4 py-3">{row.texts}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-stone-500 mt-3">
        For the full history of the education system, see <a href={`${base}/history`} class="hover:underline" style="color: #b45309;">History of the Institute</a>.
      </p>
    </section>
  </div>
</PageLayout>
