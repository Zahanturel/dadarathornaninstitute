---
import PageLayout from '../components/PageLayout.astro';
const base = import.meta.env.BASE_URL;
---

<PageLayout
  title="Admissions"
  description="New admissions at Dadar Athornan Institute — boys from priestly families (Athornans) from Std. I to III are eligible. Free education, boarding, and lodging."
  pageTitle="Admissions"
  pageSubtitle="At Athornan Boarding Madressa, Dadar"
>
  <article class="prose prose-stone max-w-none text-stone-700">
    <div class="not-prose mb-8 text-center">
      <h2 class="font-serif text-2xl font-semibold mb-1" style="color: #162d4a;">New Admissions</h2>
      <p class="text-stone-500 text-sm">At Athornan Boarding Madressa, Dadar</p>
    </div>

    <div class="text-stone-700 leading-relaxed space-y-4 text-justify">
      <p>
        New Admissions are taken at <strong>Dadar Athornan Institute</strong> every year from June. Admissions forms can be collected from the Institute office in January and submitted by March. The student and parents are called for Admission formalities in the middle of April.
      </p>

      <div class="not-prose my-6 p-5 rounded-xl border-l-4 text-stone-700 bg-amber-50" style="border-color: #b45309;">
        <p class="font-semibold mb-1" style="color: #b45309;">Eligibility</p>
        <p class="text-sm leading-relaxed">Boys belonging to priestly families <strong>(Athornans)</strong> from Std. I to III are eligible for admission.</p>
      </div>

      <h3 class="font-serif text-xl font-semibold mt-8 mb-3 not-prose" style="color: #162d4a;">What the Institute Provides</h3>
      <p>Students are provided with complete training for priesthood and academic education (including computer) upto S.S.C. at the D.P.Y.A. High School. Basic knowledge about Zoroastrian religion, Iranian history and Bhantar meaning is also taught.</p>

      <div class="not-prose my-6 grid sm:grid-cols-2 gap-4">
        {[
          { icon: '📚', label: 'Scriptural Training', desc: 'Complete 7-year training in Khordeh Avesta, Yasna, Visperad, and Vendidad' },
          { icon: '🏫', label: 'Secular Education', desc: 'Free schooling at D.P.Y.A. High School up to SSC level, with private tuitions' },
          { icon: '🏠', label: 'Boarding & Lodging', desc: 'Residential accommodation in a homely atmosphere, absolutely free' },
          { icon: '🩺', label: 'Medical Care', desc: 'Medicare centre and medical expenses covered for all students' },
          { icon: '👕', label: 'Laundry', desc: 'Laundry facilities provided to all students' },
          { icon: '💻', label: 'Computer Education', desc: 'Computer education included as part of the academic curriculum' },
        ].map(item => (
          <div class="flex gap-3 p-4 rounded-lg bg-stone-50 border border-stone-200">
            <span class="text-2xl">{item.icon}</span>
            <div>
              <p class="font-semibold text-stone-800 text-sm">{item.label}</p>
              <p class="text-stone-500 text-sm mt-0.5">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="not-prose my-6 p-5 rounded-xl bg-navy-50 border border-stone-200" style="background-color: #f0f4ff;">
        <p class="text-center font-serif text-lg font-semibold mb-1" style="color: #162d4a;">All of the above — absolutely free of cost</p>
        <p class="text-center text-stone-500 text-sm">Provided in a homely atmosphere, with complete care and mentorship.</p>
      </div>
    </div>

    <div class="not-prose mt-10 p-6 rounded-xl border border-stone-200 bg-stone-50">
      <h3 class="font-serif text-xl font-semibold mb-4" style="color: #162d4a;">Contact for Admissions</h3>
      <div class="space-y-1 text-stone-700">
        <p class="font-semibold">Er. Dr. Ramiyar P. Karanjia</p>
        <p class="text-stone-500">Principal, Dadar Athornan Institute</p>
        <p class="mt-3">651–52, Firdausi Road, Parsi Colony, Dadar,</p>
        <p>Mumbai 400 014</p>
        <p class="mt-2">
          <span class="font-medium">Tel:</span> (022) 2413 8086
        </p>
        <p>
          <span class="font-medium">Email:</span>
          <a href="mailto:info@dadarathornaninstitute.org" class="hover:underline ml-1" style="color: #b45309;">info@dadarathornaninstitute.org</a>
        </p>
      </div>
    </div>
  </article>
</PageLayout>
