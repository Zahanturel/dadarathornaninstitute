---
import PageLayout from '../components/PageLayout.astro';
import { getSscAchievers, getNirangDinPerformers } from '../lib/data';

const ssc = getSscAchievers();
const nirang = getNirangDinPerformers();
const sortedNirang = [...nirang.performers].sort((a, b) => b.count - a.count);
---

<PageLayout
  title="Achievers"
  description="Rituals and academics — SSC distinction students and top Nirang-din performers of Dadar Athornan Institute."
  pageTitle="Rituals &amp; Academics — Achievers"
  pageSubtitle="Excellence in priestly service and secular education"
>
  <div class="space-y-12">
    <section>
      <h2 class="font-serif text-2xl font-semibold mb-2 text-institute-900">
        {nirang.title}
      </h2>
      <p class="text-stone-500 text-sm mb-6">{nirang.subtitle}</p>

      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="table-header">
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-center font-medium w-40">Nirang-dins Performed</th>
              <th class="px-4 py-3 text-center font-medium w-32">Year of Passing</th>
            </tr>
          </thead>
          <tbody>
            {sortedNirang.map((n, i) => (
              <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'} hover:bg-terracotta-50 transition-colors`}>
                <td class="px-4 py-3 font-medium text-stone-800">{n.name}</td>
                <td class="px-4 py-3 text-center font-bold text-terracotta-600">{n.count}</td>
                <td class="px-4 py-3 text-center text-stone-500">{n.year}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold mb-2 text-institute-900">
        {ssc.title}
      </h2>
      <p class="text-stone-500 text-sm mb-6">{ssc.subtitle}</p>

      <div class="overflow-x-auto rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="table-header">
              <th class="px-4 py-3 text-left font-medium w-20">Year</th>
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-center font-medium w-28">Percentage</th>
            </tr>
          </thead>
          <tbody>
            {ssc.achievers.map((s, i) => (
              <tr class={`border-b border-stone-100 ${i % 2 === 0 ? 'bg-white' : 'bg-stone-50'} hover:bg-terracotta-50 transition-colors`}>
                <td class="px-4 py-3 font-semibold text-stone-500">{s.year}</td>
                <td class="px-4 py-3 font-medium text-stone-800">
                  {s.name}
                  {s.note && <span class="text-stone-400 text-xs ml-1">({s.note})</span>}
                </td>
                <td class="px-4 py-3 text-center">
                  <span
                    class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-bold ${parseFloat(s.percent) >= 85 ? 'bg-terracotta-600 text-white' : 'text-stone-700 bg-terracotta-100'}`}
                  >
                    {s.percent}%
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</PageLayout>
