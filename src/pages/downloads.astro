---
import PageLayout from '../components/PageLayout.astro';
import { getDownloads } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const downloads = getDownloads();
---

<PageLayout
  title="Downloads"
  description="Download publications, alumni lists, syllabus documents, and notices from Dadar Athornan Institute."
  pageTitle="Downloads"
  pageSubtitle="Publications, lists, and documents"
>
  <div class="space-y-10">
    {downloads.downloads.map((section) => (
      <section>
        <h2 class="font-serif text-xl font-semibold mb-4" style="color: #162d4a;">{section.category}</h2>
        <ul class="space-y-2">
          {section.items.map((item) => (
            <li>
              <a
                href={`${base}${item.href}`}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
                class="flex items-center gap-2 text-stone-700 hover:text-stone-900 hover:underline group text-sm py-2 px-3 rounded-lg hover:bg-stone-50"
              >
                <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                {item.label}
                {item.external && (
                  <svg class="w-3 h-3 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
