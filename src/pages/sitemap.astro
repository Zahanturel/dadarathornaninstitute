---
import PageLayout from '../components/PageLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections = [
  {
    title: 'Main',
    links: [
      { href: base || '/', label: 'Home' },
      { href: `${base}/donate`, label: 'Schemes & Support' },
      { href: `${base}/admissions`, label: 'Admissions' },
      { href: `${base}/contact`, label: 'Contact' },
    ],
  },
  {
    title: 'The Institute',
    links: [
      { href: `${base}/history`, label: 'History of the Institute' },
      { href: `${base}/logo`, label: 'Our Logo' },
      { href: `${base}/gallery`, label: 'Photo Gallery' },
      { href: `${base}/mandal`, label: 'Athornan Mandal' },
      { href: `${base}/education`, label: 'Education & Syllabus' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: `${base}/achievers`, label: 'Rituals & Academics — Achievers' },
      { href: `${base}/students`, label: 'Current Students (2026–27)' },
      { href: `${base}/ex-students`, label: 'Ex-Students' },
      { href: `${base}/books`, label: 'Books for Sale' },
    ],
  },
  {
    title: 'Reports',
    links: [
      { href: `${base}/activities`, label: 'Annual Reports' },
    ],
  },
];
---

<PageLayout
  title="Sitemap"
  description="Complete sitemap of the Dadar Athornan Institute website."
  pageTitle="Sitemap"
>
  <div class="space-y-10">
    {sections.map((s) => (
      <section>
        <h2 class="font-serif text-xl font-semibold mb-4 text-institute-900">{s.title}</h2>
        <ul class="space-y-2">
          {s.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
                class="flex items-center gap-2 text-stone-700 hover:text-stone-900 hover:underline group text-sm"
              >
                <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
                {link.external && (
                  <svg class="w-3 h-3 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
