---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLatestHighlights } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const highlights = getLatestHighlights();
---

<Layout title="Welcome" description="Dadar Athornan Institute — Established 1919. Training Zoroastrian priests and providing free education, boarding, and lodging to children of priestly families in Mumbai.">
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative overflow-hidden min-h-[32rem] sm:min-h-[36rem] flex items-end">
    <img
      src={`${base}/images/institute-building-hero.jpg`}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center scale-105"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-institute-950/95 via-institute-900/50 to-institute-800/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-institute-950/80 via-transparent to-transparent"></div>

    <div class="relative w-full max-w-6xl mx-auto px-4 sm:px-6 pb-14 sm:pb-20 pt-32">
      <div class="flex flex-col lg:flex-row items-start lg:items-end gap-8 lg:gap-12">
        <img
          src={`${base}/images/logo.jpg`}
          alt="Dadar Athornan Institute logo"
          class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover ring-4 ring-cream-50/20 shadow-card flex-shrink-0"
          width="144"
          height="144"
        />
        <div class="max-w-2xl">
          <p class="inline-block px-3 py-1 rounded-full text-xs font-medium tracking-wide uppercase mb-4 bg-terracotta-600/90 text-cream-50 border border-terracotta-400/30">
            Established 9th November 1919
          </p>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.25rem] font-semibold leading-[1.1] text-cream-50 text-balance">
            Dadar Athornan Institute
          </h1>
          <p class="mt-5 text-lg sm:text-xl text-cream-100/90 leading-relaxed max-w-xl">
            Nurturing the next generation of Zoroastrian priests through scripture, ritual, and secular education — free of cost, in a home away from home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Path cards -->
  <section class="relative -mt-8 sm:-mt-10 z-10 max-w-6xl mx-auto px-4 sm:px-6 pb-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
      <a href={`${base}/donate`} class="card-featured group">
        <p class="text-xs font-semibold uppercase tracking-wider text-terracotta-600 mb-2">Support</p>
        <h2 class="font-serif text-xl font-semibold text-institute-900 mb-2">Donate</h2>
        <p class="text-stone-600 text-sm leading-relaxed">Sponsor a student, fund meals, or contribute to earmarked endowment funds.</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-terracotta-600 group-hover:gap-2 transition-all">View schemes →</span>
      </a>
      <a href={`${base}/admissions`} class="card-interactive group">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-2">Join</p>
        <h2 class="font-serif text-xl font-semibold text-institute-900 mb-2">Admissions</h2>
        <p class="text-stone-600 text-sm leading-relaxed">Free education, boarding, and priestly training for boys from Athornan families.</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-institute-800 group-hover:gap-2 transition-all">Apply for admission →</span>
      </a>
      <a href={`${base}/downloads`} class="card-interactive group">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-2">Discover</p>
        <h2 class="font-serif text-xl font-semibold text-institute-900 mb-2">Explore Archive</h2>
        <p class="text-stone-600 text-sm leading-relaxed">History, annual reports, photo gallery, syllabus, and alumni records.</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-institute-800 group-hover:gap-2 transition-all">Browse archive →</span>
      </a>
    </div>
  </section>

  <!-- Latest -->
  <section class="py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="section-title">Latest from the Institute</h2>
        <div class="section-rule mx-auto mt-4"></div>
      </div>
      <div class="rounded-2xl bg-white border border-stone-200/80 shadow-soft px-6 sm:px-8 py-2">
        <ul>
          {highlights.map((item) => (
            <li class="highlight-item">
              <span class="highlight-dot" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="text-center mt-8">
        <a href={`${base}/activities`} class="link-accent">Read full annual reports →</a>
      </p>
    </div>
  </section>

  <!-- Welcome -->
  <section class="bg-cream-100/60 border-y border-stone-200/60 py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="section-title">Welcome to the Institute</h2>
        <div class="section-rule mx-auto mt-4"></div>
      </div>
      <div class="prose-institute text-center sm:text-left">
        <p>
          The <strong>Dadar Athornan Institute</strong> (formerly the Athornan Boarding Madressa, Dadar) was established as a charitable institution by the <strong>Athornan Mandal</strong> on <strong>9th November 1919</strong>.
        </p>
        <p>
          Its central mission has been to give the children of Parsi priests, especially those from mofussil areas, systematic scriptural, ritual, religious and secular education, along with boarding, lodging, and allied facilities — <strong>absolutely free of cost</strong>.
        </p>
        <p>
          More than 500 students have passed through its doors since inception. In 2019, the Institute completed <strong>100 years of dedicated service</strong> to the Zoroastrian community.
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-3 justify-center sm:justify-start">
        <a href={`${base}/history`} class="btn-secondary">Our History</a>
        <a href={`${base}/gallery`} class="btn-secondary">Photo Gallery</a>
        <a href={`${base}/logo`} class="btn-secondary">Our Logo</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-institute-900 py-14 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 text-center">
        <div>
          <div class="stat-value">100+</div>
          <div class="stat-label">Years of Service</div>
        </div>
        <div>
          <div class="stat-value">500+</div>
          <div class="stat-label">Alumni</div>
        </div>
        <div>
          <div class="stat-value">Free</div>
          <div class="stat-label">Education &amp; Boarding</div>
        </div>
        <div>
          <div class="stat-value">1919</div>
          <div class="stat-label">Year Founded</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-20 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="section-title mb-4">Support the Institute</h2>
      <p class="text-stone-600 leading-relaxed mb-8 text-[1.0625rem]">
        The Dadar Athornan Institute relies entirely on the generosity of donors and patrons to continue its century-old mission.
      </p>
      <a href={`${base}/donate`} class="btn-primary">Donate Now</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
