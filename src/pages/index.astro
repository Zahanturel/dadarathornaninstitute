---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Welcome" description="Dadar Athornan Institute — Established 1919. Training Zoroastrian priests and providing free education, boarding, and lodging to children of priestly families in Mumbai.">
  <Header slot="header" />

  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #162d4a 0%, #1e3a5f 60%, #0a1628 100%);" class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 30px, rgba(255,255,255,0.1) 30px, rgba(255,255,255,0.1) 31px);"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 py-20 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium mb-6 text-amber-300" style="background-color: rgba(180,83,9,0.2); border: 1px solid rgba(180,83,9,0.4);">
        Established 9th November 1919
      </div>
      <h1 class="text-white font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight">
        Dadar Athornan<br />
        <span style="color: #f59e0b;">Institute</span>
      </h1>
      <p class="mt-6 text-stone-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        Nurturing the next generation of Zoroastrian priests through scripture, ritual, and secular education — free of cost, in a home away from home.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={`${base}/admissions`} class="px-6 py-3 rounded-lg font-medium text-white transition-all duration-200 hover:opacity-90" style="background-color: #b45309;">
          Apply for Admission
        </a>
        <a href={`${base}/history`} class="px-6 py-3 rounded-lg font-medium text-stone-200 border border-stone-500 hover:bg-white/10 transition-all duration-200">
          Our History
        </a>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="text-center mb-10">
      <h2 class="font-serif text-3xl font-semibold mb-3" style="color: #162d4a;">Welcome to the Institute</h2>
      <div class="w-16 h-0.5 mx-auto" style="background-color: #b45309;"></div>
    </div>
    <div class="text-stone-700 leading-relaxed text-justify space-y-4 text-lg">
      <p>
        The <strong>Dadar Athornan Institute</strong> (formerly the Athornan Boarding Madressa, Dadar) was established as a charitable institution by the <strong>Athornan Mandal</strong> — an association of Zoroastrian priests — on <strong>9th November 1919</strong>.
      </p>
      <p>
        Its central mission has been to give the children of Parsi priests, especially those from mofussil areas, an opportunity to receive systematic scriptural, ritual, religious, and secular education, along with boarding, lodging, and allied facilities like medicines, books, and stationery — <strong>absolutely free of cost</strong>.
      </p>
      <p>
        Situated in the heart of Dadar Parsi Colony in Mumbai, the Institute has been a beacon of Zoroastrian learning for over a century. More than 500 students have passed through its doors since inception, and its alumni include distinguished Dasturs and Ervads who have served the community across India and the world.
      </p>
      <p>
        In 2019, the Institute completed <strong>100 years of dedicated service</strong> to the Zoroastrian community. It continues to light the lamps of devotion and learning in the hearts of young priests and inspire them to tend the holy fires.
      </p>
    </div>
  </section>

  <!-- Feature Cards -->
  <section class="bg-stone-100 py-14">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="font-serif text-2xl font-semibold" style="color: #162d4a;">Explore the Institute</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Brochure Card -->
        <a href={`${base}/brochure-2022.pdf`} target="_blank" rel="noopener" class="group bg-white rounded-xl shadow-sm border border-stone-200 p-6 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(180,83,9,0.1);">
            <svg class="w-6 h-6" style="color: #b45309;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-stone-800 mb-2">Institute Brochure</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Download our 2022 brochure for a comprehensive overview of the Institute's mission, programs, and facilities.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium transition-colors group-hover:opacity-80" style="color: #b45309;">
            Download PDF
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </span>
        </a>

        <!-- History Card -->
        <a href={`${base}/history`} class="group bg-white rounded-xl shadow-sm border border-stone-200 p-6 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(22,45,74,0.1);">
            <svg class="w-6 h-6" style="color: #162d4a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-stone-800 mb-2">History of the Institute</h3>
          <p class="text-stone-500 text-sm leading-relaxed">From its founding in 1919 to a century of Zoroastrian education — explore the rich history of the Institute and its Principals.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium transition-colors group-hover:opacity-80" style="color: #162d4a;">
            Read History
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>

        <!-- Mandal Card -->
        <a href={`${base}/mandal`} class="group bg-white rounded-xl shadow-sm border border-stone-200 p-6 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(180,83,9,0.1);">
            <svg class="w-6 h-6" style="color: #b45309;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-stone-800 mb-2">Athornan Mandal</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Learn about the Athornan Mandal — the founding body behind the Institute — and its ongoing activities supporting the priestly community.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium transition-colors group-hover:opacity-80" style="color: #b45309;">
            Learn More
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="py-12 border-y border-stone-200">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">100+</div>
          <div class="text-stone-500 text-sm mt-1">Years of Service</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">500+</div>
          <div class="text-stone-500 text-sm mt-1">Alumni</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">Free</div>
          <div class="text-stone-500 text-sm mt-1">Education &amp; Boarding</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">1919</div>
          <div class="text-stone-500 text-sm mt-1">Year Founded</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-4" style="color: #162d4a;">Support the Institute</h2>
      <p class="text-stone-600 leading-relaxed mb-8">
        The Dadar Athornan Institute relies entirely on the generosity of donors and patrons to continue its century-old mission. Your support directly sustains the education and care of young priests.
      </p>
      <a href={`${base}/help`} class="inline-block px-8 py-3 rounded-lg font-medium text-white transition-all duration-200 hover:opacity-90" style="background-color: #b45309;">
        Help &amp; Donate
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
