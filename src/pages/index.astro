---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLatestHighlights } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const highlights = getLatestHighlights();
---

<Layout title="Welcome" description="Dadar Athornan Institute — Established 1919. Training Zoroastrian priests and providing free education, boarding, and lodging to children of priestly families in Mumbai.">
  <Header slot="header" />

  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #162d4a 0%, #1e3a5f 60%, #0a1628 100%);">
    <div class="absolute inset-0 opacity-20">
      <img
        src={`${base}/images/gallery/madressa-main.jpg`}
        alt=""
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
    </div>
    <div class="relative max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="flex-shrink-0">
          <img
            src={`${base}/images/logo.jpg`}
            alt="Dadar Athornan Institute logo"
            class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover border-4 border-white/20 shadow-xl"
            width="160"
            height="160"
          />
        </div>
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium mb-4 text-amber-300" style="background-color: rgba(180,83,9,0.2); border: 1px solid rgba(180,83,9,0.4);">
            Established 9th November 1919
          </div>
          <h1 class="text-white font-serif text-4xl sm:text-5xl font-semibold leading-tight">
            Dadar Athornan Institute
          </h1>
          <p class="mt-4 text-stone-300 text-lg leading-relaxed max-w-xl">
            Nurturing the next generation of Zoroastrian priests through scripture, ritual, and secular education — free of cost, in a home away from home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href={`${base}/donate`} class="group p-6 rounded-xl border-2 border-amber-200 bg-amber-50 hover:border-amber-400 hover:shadow-md transition-all">
        <h2 class="font-serif text-xl font-semibold mb-2" style="color: #162d4a;">Donate</h2>
        <p class="text-stone-600 text-sm leading-relaxed">Support our students through sponsorship schemes, meals, and earmarked funds.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium" style="color: #b45309;">View schemes →</span>
      </a>
      <a href={`${base}/admissions`} class="group p-6 rounded-xl border border-stone-200 bg-white hover:border-stone-400 hover:shadow-md transition-all">
        <h2 class="font-serif text-xl font-semibold mb-2" style="color: #162d4a;">Admissions</h2>
        <p class="text-stone-600 text-sm leading-relaxed">Free education, boarding, and priestly training for boys from Athornan families.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium" style="color: #162d4a;">Apply for admission →</span>
      </a>
      <a href={`${base}/downloads`} class="group p-6 rounded-xl border border-stone-200 bg-white hover:border-stone-400 hover:shadow-md transition-all">
        <h2 class="font-serif text-xl font-semibold mb-2" style="color: #162d4a;">Explore Archive</h2>
        <p class="text-stone-600 text-sm leading-relaxed">History, alumni lists, annual reports, photos, and publications — all preserved online.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium" style="color: #162d4a;">Browse archive →</span>
      </a>
    </div>
  </section>

  <section class="bg-stone-100 py-10">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-xl font-semibold mb-4 text-center" style="color: #162d4a;">Latest from the Institute</h2>
      <ul class="space-y-2">
        {highlights.map((item) => (
          <li class="flex gap-3 text-sm text-stone-700">
            <span class="flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full" style="background-color: #b45309;"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="text-center mt-4">
        <a href={`${base}/activities`} class="text-sm font-medium hover:underline" style="color: #b45309;">Read full annual reports →</a>
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="text-center mb-8">
      <h2 class="font-serif text-3xl font-semibold mb-3" style="color: #162d4a;">Welcome to the Institute</h2>
      <div class="w-16 h-0.5 mx-auto" style="background-color: #b45309;"></div>
    </div>
    <div class="text-stone-700 leading-relaxed text-justify space-y-4">
      <p>
        The <strong>Dadar Athornan Institute</strong> (formerly the Athornan Boarding Madressa, Dadar) was established as a charitable institution by the <strong>Athornan Mandal</strong> on <strong>9th November 1919</strong>.
      </p>
      <p>
        Its central mission has been to give the children of Parsi priests, especially those from mofussil areas, systematic scriptural, ritual, religious and secular education, along with boarding, lodging, and allied facilities — <strong>absolutely free of cost</strong>.
      </p>
      <p>
        More than 500 students have passed through its doors since inception. In 2019, the Institute completed <strong>100 years of dedicated service</strong> to the Zoroastrian community.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
      <a href={`${base}/history`} class="px-5 py-2.5 rounded-lg text-sm font-medium border border-stone-300 text-stone-700 hover:bg-stone-50">Our History</a>
      <a href={`${base}/gallery`} class="px-5 py-2.5 rounded-lg text-sm font-medium border border-stone-300 text-stone-700 hover:bg-stone-50">Photo Gallery</a>
      <a href={`${base}/logo`} class="px-5 py-2.5 rounded-lg text-sm font-medium border border-stone-300 text-stone-700 hover:bg-stone-50">Our Logo</a>
    </div>
  </section>

  <section class="py-12 border-y border-stone-200">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">100+</div>
          <div class="text-stone-500 text-sm mt-1">Years of Service</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">500+</div>
          <div class="text-stone-500 text-sm mt-1">Alumni</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">Free</div>
          <div class="text-stone-500 text-sm mt-1">Education &amp; Boarding</div>
        </div>
        <div>
          <div class="font-serif text-4xl font-semibold" style="color: #b45309;">1919</div>
          <div class="text-stone-500 text-sm mt-1">Year Founded</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-4" style="color: #162d4a;">Support the Institute</h2>
      <p class="text-stone-600 leading-relaxed mb-8">
        The Dadar Athornan Institute relies entirely on the generosity of donors and patrons to continue its century-old mission.
      </p>
      <a href={`${base}/donate`} class="inline-block px-8 py-3 rounded-lg font-medium text-white transition-all duration-200 hover:opacity-90" style="background-color: #b45309;">
        Donate Now
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
