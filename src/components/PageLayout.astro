---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  pageSubtitle?: string;
}

const { title, description, pageTitle, pageSubtitle } = Astro.props;
---

<Layout title={title} description={description}>
  <Header slot="header" />

  {pageTitle && (
    <div class="page-hero">
      <div class="max-w-4xl mx-auto">
        <h1 class="page-hero-title">{pageTitle}</h1>
        {pageSubtitle && <p class="page-hero-subtitle">{pageSubtitle}</p>}
      </div>
    </div>
  )}

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12">
    <slot />
  </div>

  <Footer slot="footer" />
</Layout>
