---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/activities', label: 'Activities' },
  { href: '/history', label: 'History' },
  { href: '/admissions', label: 'Admissions' },
  { href: '/books', label: 'Books' },
  { href: '/mandal', label: 'Mandal' },
  { href: '/achievers', label: 'Achievers' },
  { href: '/students', label: 'Students' },
  { href: '/help', label: 'Help & Donate' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-navy-800 sticky top-0 z-50 shadow-lg" style="background-color: #162d4a;">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #b45309;">
          <span class="text-white font-serif font-bold text-lg">D</span>
        </div>
        <div class="hidden sm:block">
          <span class="text-white font-serif font-semibold text-sm leading-tight block">Dadar Athornan Institute</span>
          <span class="text-stone-400 text-xs">Est. 1919 · Mumbai</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded text-sm font-medium transition-colors duration-150 whitespace-nowrap ${
                isActive
                  ? 'text-amber-400 bg-white/10'
                  : 'text-stone-300 hover:text-white hover:bg-white/10'
              }`}
              style={isActive ? 'color: #f59e0b;' : ''}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded text-stone-300 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${
              isActive
                ? 'text-amber-400 bg-white/10'
                : 'text-stone-300 hover:text-white hover:bg-white/10'
            }`}
            style={isActive ? 'color: #f59e0b;' : ''}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
