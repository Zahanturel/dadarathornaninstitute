---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${base}/donate`, label: 'Donate' },
  { href: `${base}/admissions`, label: 'Admissions' },
  {
    label: 'Institute',
    children: [
      { href: `${base}/history`, label: 'History' },
      { href: `${base}/logo`, label: 'Our Logo' },
      { href: `${base}/gallery`, label: 'Photo Gallery' },
      { href: `${base}/mandal`, label: 'Athornan Mandal' },
      { href: `${base}/education`, label: 'Education & Syllabus' },
    ],
  },
  {
    label: 'Community',
    children: [
      { href: `${base}/achievers`, label: 'Achievers' },
      { href: `${base}/students`, label: 'Current Students' },
      { href: `${base}/ex-students`, label: 'Ex-Students' },
      { href: `${base}/books`, label: 'Books for Sale' },
      { href: `${base}/downloads`, label: 'Downloads' },
    ],
  },
  { href: `${base}/activities`, label: 'Reports' },
  { href: `${base}/contact`, label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (!href) return false;
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized || (normalized !== (base || '/') && currentPath.startsWith(normalized));
}

function groupActive(children: { href: string }[]) {
  return children.some((c) => isActive(c.href));
}
---

<header class="sticky top-0 z-50 shadow-lg" style="background-color: #162d4a;">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href={base || '/'} class="flex items-center gap-3 group">
        <img
          src={`${base}/images/logo.jpg`}
          alt="Dadar Athornan Institute logo"
          class="w-10 h-10 rounded-full object-cover flex-shrink-0 border border-white/20"
          width="40"
          height="40"
        />
        <div class="hidden sm:block">
          <span class="text-white font-serif font-semibold text-sm leading-tight block">Dadar Athornan Institute</span>
          <span class="text-stone-400 text-xs">Est. 1919 · Mumbai</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => {
          if (item.children) {
            const active = groupActive(item.children);
            return (
              <div class="relative group/nav">
                <button
                  type="button"
                  class={`px-3 py-2 rounded text-sm font-medium transition-colors duration-150 whitespace-nowrap flex items-center gap-1 ${
                    active ? 'bg-white/10' : 'text-stone-300 hover:text-white hover:bg-white/10'
                  }`}
                  style={active ? 'color: #f59e0b;' : ''}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="absolute top-full left-0 pt-1 hidden group-hover/nav:block group-focus-within/nav:block min-w-[200px]">
                  <div class="bg-white rounded-lg shadow-xl border border-stone-200 py-2">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class={`block px-4 py-2 text-sm transition-colors ${
                          isActive(child.href)
                            ? 'text-amber-700 bg-amber-50 font-medium'
                            : 'text-stone-700 hover:bg-stone-50'
                        }`}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }
          const active = isActive(item.href!);
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded text-sm font-medium transition-colors duration-150 whitespace-nowrap ${
                active ? 'bg-white/10' : 'text-stone-300 hover:text-white hover:bg-white/10'
              }`}
              style={active ? 'color: #f59e0b;' : ''}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded text-stone-300 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10 max-h-[80vh] overflow-y-auto">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navItems.map((item) => {
        if (item.children) {
          return (
            <details class="group">
              <summary class="px-3 py-2 rounded text-sm font-medium text-stone-300 cursor-pointer list-none flex items-center justify-between">
                {item.label}
                <svg class="w-4 h-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="pl-4 pb-2 flex flex-col gap-1">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`px-3 py-2 rounded text-sm ${
                      isActive(child.href) ? 'text-amber-400 bg-white/10' : 'text-stone-400 hover:text-white'
                    }`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </details>
          );
        }
        const active = isActive(item.href!);
        return (
          <a
            href={item.href}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${
              active ? 'bg-white/10' : 'text-stone-300 hover:text-white hover:bg-white/10'
            }`}
            style={active ? 'color: #f59e0b;' : ''}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
