---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${base}/donate`, label: 'Schemes & Support' },
  { href: `${base}/admissions`, label: 'Admissions' },
  {
    label: 'Institute',
    children: [
      { href: `${base}/history`, label: 'History' },
      { href: `${base}/logo`, label: 'Our Logo' },
      { href: `${base}/gallery`, label: 'Photo Gallery' },
      { href: `${base}/mandal`, label: 'Athornan Mandal' },
      { href: `${base}/education`, label: 'Education & Syllabus' },
    ],
  },
  {
    label: 'Community',
    children: [
      { href: `${base}/achievers`, label: 'Achievers' },
      { href: `${base}/students`, label: 'Current Students' },
      { href: `${base}/ex-students`, label: 'Ex-Students' },
      { href: `${base}/books`, label: 'Books for Sale' },
    ],
  },
  { href: `${base}/activities`, label: 'Reports' },
  { href: `${base}/contact`, label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (!href) return false;
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized || (normalized !== (base || '/') && currentPath.startsWith(normalized));
}

function groupActive(children: { href: string }[]) {
  return children.some((c) => isActive(c.href));
}
---

<header class="sticky top-0 z-50 bg-institute-950/95 backdrop-blur-md shadow-header border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-[4.25rem]">
      <a href={base || '/'} class="flex items-center gap-3 group min-w-0">
        <img
          src={`${base}/images/logo.jpg`}
          alt="Dadar Athornan Institute logo"
          class="w-11 h-11 rounded-full object-cover flex-shrink-0 ring-2 ring-white/15 group-hover:ring-terracotta-400/40 transition-all"
          width="44"
          height="44"
        />
        <div class="hidden sm:block min-w-0">
          <span class="text-cream-50 font-serif font-semibold text-[0.9375rem] leading-tight block truncate">Dadar Athornan Institute</span>
          <span class="text-cream-200/50 text-xs tracking-wide">Est. 1919 · Mumbai</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-0.5">
        {navItems.map((item) => {
          if (item.children) {
            const active = groupActive(item.children);
            return (
              <div class="relative group/nav">
                <button
                  type="button"
                  class={active ? 'nav-link-active' : 'nav-link'}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="w-4 h-4 opacity-60 inline-block ml-0.5 -mt-px" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="absolute top-full left-0 pt-2 hidden group-hover/nav:block group-focus-within/nav:block min-w-[220px]">
                  <div class="bg-white rounded-xl shadow-card border border-stone-200/80 py-1.5 overflow-hidden">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class={`block px-4 py-2.5 text-sm transition-colors ${
                          isActive(child.href)
                            ? 'text-terracotta-700 bg-terracotta-50 font-medium'
                            : 'text-stone-700 hover:bg-cream-100'
                        }`}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }
          const active = isActive(item.href!);
          return (
            <a href={item.href} class={active ? 'nav-link-active' : 'nav-link'}>
              {item.label}
            </a>
          );
        })}
      </nav>

      <button
        id="menu-toggle"
        class="lg:hidden p-2.5 rounded-lg text-cream-200 hover:text-cream-50 hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10 bg-institute-950 max-h-[80vh] overflow-y-auto">
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      {navItems.map((item) => {
        if (item.children) {
          return (
            <details class="group">
              <summary class="px-3 py-2.5 rounded-lg text-sm font-medium text-cream-200 cursor-pointer list-none flex items-center justify-between hover:bg-white/5">
                {item.label}
                <svg class="w-4 h-4 group-open:rotate-180 transition-transform opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="pl-3 pb-2 flex flex-col gap-0.5 mt-1">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`px-3 py-2 rounded-lg text-sm transition-colors ${
                      isActive(child.href) ? 'text-terracotta-300 bg-white/10 font-medium' : 'text-cream-200/70 hover:text-cream-50 hover:bg-white/5'
                    }`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </details>
          );
        }
        const active = isActive(item.href!);
        return (
          <a
            href={item.href}
            class={`px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              active ? 'text-terracotta-300 bg-white/10' : 'text-cream-200 hover:text-cream-50 hover:bg-white/5'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
